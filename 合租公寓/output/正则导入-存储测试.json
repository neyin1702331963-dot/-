{
  "pageDepth": 2,
  "statusbar": "",
  "beginning": "浏览器存储/缓存探针（载体 img onerror）。\n应出现 4 个框：绿=可用 / 红=被禁。\n★关键：记下 A/B 的「累计运行」数字，刷新或重进聊天后再看——\n  数字变大=缓存能持久化；一直是 1 或报错=被沙箱隔离。\n<storeprobe>",
  "regex_scripts": [
    {
      "id": -1,
      "scriptName": "存储探针",
      "findRegex": "<storeprobe>",
      "replaceString": "<img src='x' style='display:none' onerror=\"(function(e){var d=document.createElement('div');d.style.margin='6px';d.style.padding='8px';d.style.borderRadius='6px';d.style.fontSize='13px';d.style.background='#fff3cd';d.style.color='#856404';d.textContent='⧗ A localStorage：未执行';e.parentNode.insertBefore(d,e.nextSibling);try{localStorage.setItem('mmd_ls','ok');var v=localStorage.getItem('mmd_ls');if(v!=='ok')throw '读回不一致';var n=(parseInt(localStorage.getItem('mmd_ls_n'))||0)+1;localStorage.setItem('mmd_ls_n',n);d.textContent='✓ A localStorage 可用｜读回='+v+'｜累计运行='+n+' 次（刷新后应+1）';d.style.background='#e6f7e6';d.style.color='#1a7f1a'}catch(err){d.style.background='#fdeaea';d.style.color='#b00020';d.textContent='✗ A localStorage 不可用 → '+err}})(this)\"><img src='x' style='display:none' onerror=\"(function(e){var d=document.createElement('div');d.style.margin='6px';d.style.padding='8px';d.style.borderRadius='6px';d.style.fontSize='13px';d.style.background='#fff3cd';d.style.color='#856404';d.textContent='⧗ B sessionStorage：未执行';e.parentNode.insertBefore(d,e.nextSibling);try{sessionStorage.setItem('mmd_ss','ok');var v=sessionStorage.getItem('mmd_ss');if(v!=='ok')throw '读回不一致';var n=(parseInt(sessionStorage.getItem('mmd_ss_n'))||0)+1;sessionStorage.setItem('mmd_ss_n',n);d.textContent='✓ B sessionStorage 可用｜累计运行='+n+' 次';d.style.background='#e6f7e6';d.style.color='#1a7f1a'}catch(err){d.style.background='#fdeaea';d.style.color='#b00020';d.textContent='✗ B sessionStorage 不可用 → '+err}})(this)\"><img src='x' style='display:none' onerror=\"(function(e){var d=document.createElement('div');d.style.margin='6px';d.style.padding='8px';d.style.borderRadius='6px';d.style.fontSize='13px';d.style.background='#fff3cd';d.style.color='#856404';d.textContent='⧗ C cookie：未执行';e.parentNode.insertBefore(d,e.nextSibling);try{document.cookie='mmd_ck=ok;path=/';if(document.cookie.indexOf('mmd_ck=ok')===-1)throw 'cookie 未写入';d.textContent='✓ C cookie 可用｜cookie 串长='+document.cookie.length;d.style.background='#e6f7e6';d.style.color='#1a7f1a'}catch(err){d.style.background='#fdeaea';d.style.color='#b00020';d.textContent='✗ C cookie 不可用 → '+err}})(this)\"><img src='x' style='display:none' onerror=\"(function(e){var d=document.createElement('div');d.style.margin='6px';d.style.padding='8px';d.style.borderRadius='6px';d.style.fontSize='13px';d.style.background='#fff3cd';d.style.color='#856404';d.textContent='⧗ D indexedDB：未执行';e.parentNode.insertBefore(d,e.nextSibling);try{if(!window.indexedDB)throw 'indexedDB 接口不存在';d.textContent='✓ D indexedDB 接口存在（异步库，可用于大数据缓存）';d.style.background='#e6f7e6';d.style.color='#1a7f1a'}catch(err){d.style.background='#fdeaea';d.style.color='#b00020';d.textContent='✗ D indexedDB 不可用 → '+err}})(this)\">"
    }
  ]
}