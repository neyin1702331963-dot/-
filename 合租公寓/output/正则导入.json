      "replaceString": "<img src='x' style='display:none' onerror=\"(function(e){var run=function(){var b=e,curr=e,c=5,fnd=false;while(c>0&&curr.parentNode&&curr.parentNode.tagName!=='BODY'){c--;curr=curr.parentNode;if(curr.classList&&(curr.classList.contains('item')||curr.classList.contains('content')||curr.classList.contains('vditor-reset')||curr.classList.contains('vditor-ir')||curr.classList.contains('vditor-preview'))){b=curr;fnd=true;c=0;}}if(!fnd){b=e.parentNode;if(b&&(b.tagName==='P'||b.tagName==='FONT'||b.tagName==='SPAN'))b=b.parentNode;}var trim=function(s){return s.replace(/(^\\s+)|(\\s+$)/g,'');};var reg=new RegExp('\\\\[([^=\\\\[\\\\]]+)=([^\\\\[\\\\]]+)\\\\]','g');var cur={},opts=[],m;while((m=reg.exec(b.textContent))!==null){var kk=trim(m[1]),vv=trim(m[2]);if(kk.indexOf('选项')===0&&kk!=='选项标题'){opts.push(vv);}else{cur[kk]=vv;}}var hist={};var els=document.querySelectorAll('.item, .content, .vditor-reset, .vditor-ir, .vditor-preview');for(var i=0;i<els.length;i++){if(b.compareDocumentPosition(els[i])&2){var tx=els[i].textContent;if(tx.indexOf('[')===-1)continue;reg.lastIndex=0;while((m=reg.exec(tx))!==null){hist[trim(m[1])]=trim(m[2]);}}}var gv=function(k,fb){if(cur[k]!==undefined)return cur[k];if(fb&&hist[k]!==undefined)return hist[k];return null;};var loc=gv('当前地点',true),tm=gv('当前时间',true),sit=gv('当前情境',true),rnd=gv('回复轮次',true);var present=[];if(cur['在场角色']){var ps=cur['在场角色'].split(/[|｜,，]+/);for(var pj=0;pj<ps.length;pj++){var nm=trim(ps[pj]);if(nm)present.push(nm);}}var optTitle=cur['选项标题']||hist['选项标题']||'接下来：';var hash=loc+'|'+tm+'|'+sit+'|'+rnd+'|'+present.join('~');for(var pi=0;pi<present.length;pi++){var pn=present[pi];hash+='#'+pn+':'+gv('角色-'+pn+'-好感',true)+':'+(cur['角色-'+pn+'-状态']||'');}hash+='||'+opts.join('~');var sid=e.getAttribute('data-sid');if(!sid){var h=0;for(var si=0;si<hash.length;si++)h=Math.imul(31,h)+hash.charCodeAt(si)|0;sid='hz'+h;e.setAttribute('data-sid',sid);}if(e.rdrNode&&document.body.contains(e.rdrNode)&&e.rdrNode.getAttribute('data-h')===hash)return;if(e.rdrNode&&e.rdrNode.parentNode)e.rdrNode.remove();var mk=function(cl){var d=document.createElement('div');if(cl)d.className=cl;return d;};var sp=function(t,cl){var s=document.createElement('span');if(cl)s.className=cl;if(t)s.textContent=t;return s;};var nC=mk('hz-box');nC.id=sid;nC.setAttribute('data-h',hash);nC.onmousedown=function(ev){ev.stopPropagation();};nC.onclick=function(ev){ev.stopPropagation();};var ti=mk('hz-title');ti.textContent='合租公寓 · 当前状态';nC.appendChild(ti);var env=mk('hz-env');var addRow=function(lbl,val){if(!val)return;var r=mk('hz-row');r.appendChild(sp(lbl,'hz-lbl'));r.appendChild(sp(val,'hz-val'));env.appendChild(r);};addRow('时间',tm);addRow('地点',loc);addRow('此刻',sit);nC.appendChild(env);if(present.length){var cwrap=mk('hz-chars');for(var pi2=0;pi2<present.length;pi2++){var pn2=present[pi2];var card=mk('hz-card');var head=mk('hz-chead');var av=mk('hz-av');av.textContent=pn2.charAt(0);head.appendChild(av);var nfo=mk('hz-cinfo');var nmd=mk('hz-cname');nmd.textContent=pn2;nfo.appendChild(nmd);var role=gv('角色-'+pn2+'-身份',true);if(role){var rdv=mk('hz-crole');rdv.textContent=role;nfo.appendChild(rdv);}head.appendChild(nfo);var fav=gv('角色-'+pn2+'-好感',true);var fm=fav?fav.match(/(-?\\d+)[^\\d]+(\\d+)/):null;if(fm){head.appendChild(sp('好感 '+fm[1]+'/'+fm[2],'hz-fav'));}card.appendChild(head);if(fm){var bg=mk('hz-bar');var fl=mk('hz-fill');var mx=parseInt(fm[2]);var pct=mx>0?Math.min(100,Math.max(0,(parseInt(fm[1])/mx)/0.01)):0;fl.style.width=pct+'%';bg.appendChild(fl);card.appendChild(bg);}var stt=cur['角色-'+pn2+'-状态'];if(stt){var sd=mk('hz-cst');sd.textContent=stt;card.appendChild(sd);}cwrap.appendChild(card);}nC.appendChild(cwrap);}if(opts.length){var ow=mk('hz-opts');var oh=mk('hz-ohead');oh.textContent=optTitle;ow.appendChild(oh);for(var oi=0;oi<opts.length;oi++){var os=opts[oi].split(/[|｜]+/);var ob=mk('hz-opt');var ot=mk('hz-ot');ot.textContent=os[0]||'选项';ob.appendChild(ot);if(os[1]){var od=mk('hz-od');od.textContent=os[1];ob.appendChild(od);}ob.setAttribute('data-cmd',os[0]||'');ob.onclick=function(ev){ev.stopPropagation();var a=document.querySelector('.uni-textarea-textarea');if(a){a.value=this.getAttribute('data-cmd');a.dispatchEvent(new Event('input',{bubbles:true}));}};ow.appendChild(ob);}nC.appendChild(ow);}if(rnd){var rb=mk('hz-rnd');rb.textContent='第 '+rnd+' 轮';nC.appendChild(rb);}if(e.parentNode)e.parentNode.insertBefore(nC,e.nextSibling);e.rdrNode=nC;};run();var rc=5;var iv=setInterval(function(){if(!document.body.contains(e)){if(e.rdrNode&&e.rdrNode.parentNode)e.rdrNode.remove();clearInterval(iv);return;}if(e.rdrNode&&!document.body.contains(e.rdrNode))run();rc--;if(rc<=0)clearInterval(iv);},500);})(this)\">"
