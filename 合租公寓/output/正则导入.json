      "replaceString": "<style>.hz-box{width:96%;max-width:none;margin:14px auto;background:linear-gradient(150deg,#fdf6ee,#f6e6d3);color:#5a4636;font-family:sans-serif;padding:14px;border-radius:14px;border:1px solid #e6c9a8;box-shadow:0 6px 18px rgba(150,110,70,0.18);line-height:1.6;box-sizing:border-box;overflow-wrap:break-word;}.hz-box *{box-sizing:border-box;}.hz-title{text-align:center;font-size:16px;font-weight:bold;color:#b5651d;letter-spacing:1px;padding-bottom:10px;margin-bottom:12px;border-bottom:1px dashed #e0b98f;}.hz-env{background:#fffaf3;border:1px solid #efd9bf;border-radius:10px;padding:8px 12px;margin-bottom:12px;}.hz-row{display:flex;padding:4px 0;font-size:13px;}.hz-lbl{width:44px;color:#a98e6f;flex-shrink:0;}.hz-val{color:#5a4636;flex:1;}.hz-chars{display:flex;flex-direction:column;gap:10px;margin-bottom:12px;}.hz-card{background:#fffaf3;border:1px solid #efd9bf;border-left:4px solid #d99a5e;border-radius:10px;padding:10px 12px;}.hz-chead{display:flex;align-items:center;gap:10px;}.hz-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#f0c89c,#d99a5e);color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:bold;flex-shrink:0;}.hz-cinfo{flex:1;}.hz-cname{font-size:14px;font-weight:bold;color:#5a4636;}.hz-crole{font-size:11px;color:#a98e6f;}.hz-fav{font-size:11px;color:#b5651d;background:#f7e6d2;padding:2px 8px;border-radius:10px;white-space:nowrap;}.hz-bar{height:6px;background:#f0e0cd;border-radius:3px;overflow:hidden;margin-top:8px;}.hz-fill{height:100%;background:linear-gradient(90deg,#f0b97f,#c8794f);border-radius:3px;transition:width 0.3s;}.hz-cst{font-size:12px;color:#7a6450;margin-top:8px;background:#fbf2e6;border-radius:6px;padding:6px 8px;}.hz-opts{margin-top:4px;}.hz-ohead{font-size:12px;color:#b5651d;font-weight:bold;margin-bottom:8px;}.hz-opt{background:#fff8f0;border:1px solid #ecd6bb;border-radius:8px;padding:10px;margin-bottom:8px;cursor:pointer;transition:all 0.2s;}.h